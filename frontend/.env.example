# Copy this file to .env and fill in your values. .env is gitignored.

# Same Supabase project the backend points at (Project Settings > API Keys).
# This is the public publishable key (sb_publishable_...), not the backend's
# secret key. SUPABASE_ANON_KEY (legacy anon JWT) is still read as a fallback
# if SUPABASE_PUBLISHABLE_KEY is unset.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# FastAPI backend base URL.
API_BASE_URL=http://localhost:8000
